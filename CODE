#include <iostream>
#include <string>
#include <vector>
#include <fstream>
#include <sstream>
#include <limits>

class FoodItem {
private:
    std::string name;
    int daysToExpiration;
    double quantity;

public:
    FoodItem() : name(""), daysToExpiration(0), quantity(0.0) {}

    FoodItem(std::string p_name, int p_days, double p_qty) 
        : name(p_name), daysToExpiration(p_days), quantity(p_qty) {}

    std::string getName() const { return name; }
    int getDaysToExpiration() const { return daysToExpiration; }
    double getQuantity() const { return quantity; }
    
    void setQuantity(double p_qty) { 
        if (p_qty >= 0.0) {
            quantity = p_qty; 
        }
    }

    void reduceDays() { 
        daysToExpiration--; 
    }
    
    bool isSpoiled() const { 
        return daysToExpiration <= 0; 
    }
    
    double getWasteRiskScore() const {
        if (daysToExpiration <= 0) return 100.0;
        if (daysToExpiration > 7) return 10.0;
        return (1.0 / daysToExpiration) * quantity * 10.0;
    }
};

class PantryManager {
private:
    std::vector<FoodItem> inventory; 

    int findItemIndex(const std::string& name) const {
        for (size_t i = 0; i < inventory.size(); ++i) {
            if (inventory[i].getName() == name) {
                return static_cast<int>(i);
            }
        }
        return -1; 
    }

public:
    void addItem(const FoodItem& item) {
        inventory.push_back(item);
        std::cout << "\n>>> [SUCCESS] Resource \"" << item.getName() << "\" appended.\n";
    }

    void displayInventory() const {
        if (inventory.empty()) {
            std::cout << "\n[Notice: Inventory is empty.]\n";
            return;
        }
        std::cout << "\n===================================================\n";
        std::cout << "             CURRENT PANTRY STOCK                  \n";
        std::cout << "===================================================\n";
        for (const auto& item : inventory) {
            std::cout << " * " << item.getName() 
                      << " | Qty: " << item.getQuantity() 
                      << " | Expiration: " << item.getDaysToExpiration() << " Days";
            
            if (item.isSpoiled()) {
                std::cout << " -> [CRITICAL: SPOILED / SCORE: " << item.getWasteRiskScore() << "]";
            } else if (item.getDaysToExpiration() <= 2) {
                std::cout << " -> [WARNING: CONSUME IMMEDIATELY]";
            }
            std::cout << "\n";
        }
        std::cout << "===================================================\n";
    }

    bool restockItem(const std::string& name, int newDays, double additionalQty) {
        int index = findItemIndex(name);
        if (index != -1) {
            double combinedQty = inventory[index].getQuantity() + additionalQty;
            inventory[index] = FoodItem(name, newDays, combinedQty);
            return true;
        }
        return false;
    }

    bool deleteItem(const std::string& name) {
        int index = findItemIndex(name);
        if (index != -1) {
            inventory.erase(inventory.begin() + index);
            return true;
        }
        return false;
    }

    void simulateDay() {
        if (inventory.empty()) {
            std::cout << "\n[Notice: Simulation skipped. Empty inventory.]\n";
            return;
        }
        for (auto& item : inventory) {
            item.reduceDays();
        }
        std::cout << "\n>>> [SYSTEM] 24 Hours elapsed.\n";
    }

    void loadFromFile(const std::string& filename) {
        std::ifstream file(filename);
        if (!file.is_open()) return; 

        std::string line, name;
        int days; 
        double qty;

        inventory.clear();
        while (std::getline(file, line)) {
            std::stringstream ss(line);
            if (std::getline(ss, name, ',') && ss >> days && ss.ignore() && ss >> qty) {
                inventory.push_back(FoodItem(name, days, qty));
            }
        }
        file.close();
    }

    void saveToFile(const std::string& filename) const {
        std::ofstream file(filename);
        if (!file.is_open()) {
            std::cerr << "\n[ERROR] Could not save to file.\n";
            return;
        }
        for (const auto& item : inventory) {
            file << item.getName() << "," 
                 << item.getDaysToExpiration() << "," 
                 << item.getQuantity() << "\n";
        }
        file.close();
    }
};

void displayMenu() {
    std::cout << "\n===================================================\n";
    std::cout << "               PANTRY MANAGER                      \n";
    std::cout << "===================================================\n";
    std::cout << " 1. Display Inventory\n";
    std::cout << " 2. Add New Item\n";
    std::cout << " 3. Restock Item\n";
    std::cout << " 4. Delete Item\n";
    std::cout << " 5. Advance Simulation (1 Day)\n";
    std::cout << " 6. Exit\n";
    std::cout << "===================================================\n";
    std::cout << "Select option (1-6): ";
}

int main() {
    PantryManager manager;
    const std::string databasePath = "pantry_db.txt";

    manager.loadFromFile(databasePath);

    int selection = 0;
    while (selection != 6) {
        displayMenu();
        
        if (!(std::cin >> selection)) {
            std::cin.clear();
            std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
            continue;
        }

        if (selection == 1) {
            manager.displayInventory();
        } 
        else if (selection == 2) {
            std::string name; int days; double qty;
            std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
            std::cout << "Enter item name: "; 
            std::getline(std::cin, name);
            std::cout << "Enter days until expiration: "; 
            std::cin >> days;
            std::cout << "Enter quantity: "; 
            std::cin >> qty;
            manager.addItem(FoodItem(name, days, qty));
        } 
        else if (selection == 3) {
            std::string name; int days; double qty;
            std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
            std::cout << "Enter item name to update: "; 
            std::getline(std::cin, name);
            std::cout << "Enter new expiration days: "; 
            std::cin >> days;
            std::cout << "Enter additional quantity: "; 
            std::cin >> qty;
            if (manager.restockItem(name, days, qty)) {
                std::cout << "\n>>> [SUCCESS] Item updated.\n";
            } else {
                std::cout << "\n>>> [ERROR] Item not found.\n";
            }
        } 
        else if (selection == 4) {
            std::string name;
            std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
            std::cout << "Enter item name to delete: "; 
            std::getline(std::cin, name);
            if (manager.deleteItem(name)) {
                std::cout << "\n>>> [SUCCESS] Item deleted.\n";
            } else {
                std::cout << "\n>>> [ERROR] Item not found.\n";
            }
        } 
        else if (selection == 5) {
            manager.simulateDay();
        }
    }

    manager.saveToFile(databasePath);
    std::cout << "\n>>> [SYSTEM] Data saved. Goodbye.\n";
    return 0;
}
